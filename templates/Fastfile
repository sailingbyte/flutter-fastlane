# Copy to <app>/fastlane/Fastfile. Pull the shared lanes from the shared repo.
#
# CI:    nothing to set - pulls https://github.com/sailingbyte/flutter-fastlane.git (override with FASTLANE_SHARED_URL)
# Local: FASTLANE_SHARED_PATH=/path/to/checkout/of/flutter-fastlane   (edit the shared lanes without pushing)

if ENV["FASTLANE_SHARED_PATH"].to_s.empty?
  import_from_git(
    url: ENV.fetch("FASTLANE_SHARED_URL", "https://github.com/sailingbyte/flutter-fastlane.git"),
    branch: ENV.fetch("FASTLANE_SHARED_REF", "master"), # pin to a tag (e.g. v1) once stable
    path: "fastlane/Fastfile"
  )
else
  import(File.join(ENV["FASTLANE_SHARED_PATH"], "fastlane", "Fastfile"))
end
