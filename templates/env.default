# Copy to <app>/fastlane/.env.default (fastlane loads it automatically).
# NON-SECRET, per-app config only. Secrets come from CI variables.

APP_NAME=MyApp
ANDROID_PACKAGE_NAME=com.example.app
FASTLANE_TEAM_ID=ABCDE12345
# Archived Xcode targets and their bundle ids (first = main app)
IOS_TARGETS=Runner:com.example.app
IOS_SCHEME=Runner

# Store defaults (all optional)
# ANDROID_BETA_TRACK=internal
# ANDROID_RELEASE_TRACK=production
# SUBMIT_FOR_REVIEW=false               # true = also send releases to store review (or per platform:
# ANDROID_SUBMIT_FOR_REVIEW / IOS_SUBMIT_FOR_REVIEW)
# IOS_AUTOMATIC_RELEASE=false
# IOS_WAIT_FOR_PROCESSING=true          # needed for the TestFlight changelog
# BETA_CHANGELOG_FALLBACK=Test build   # used when fastlane/changelogs/<version>.txt is missing on test/* branches

# Screenshots - CI variable SCREENSHOTS_ENABLED=true turns them on for this app
# SCREENSHOT_LOCALE=en-US
# SCREENSHOT_IOS_DEVICES=iPhone 16 Pro Max,iPad Pro 13-inch (M4)
# SCREENSHOT_ANDROID_DEVICES=emulator-5554:phoneScreenshots,emulator-5556:tenInchScreenshots
